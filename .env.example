LLM_BASE_URL=https://your-llm-provider/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=qwen3-max

# GitHub Actions uses an encrypted LLM_API_KEY repository secret. Configure
# LLM_BASE_URL and LLM_MODEL as repository variables; GitHub Models and its
# models.github.ai/inference endpoint are retired and must not be used.

# First-party model APIs used by `task official-identity` to corroborate the
# identity of closed-publisher models. A key that is unset makes that publisher
# report skipped_no_credentials instead of failing.
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-google-gemini-api-key
XAI_API_KEY=your-xai-api-key
